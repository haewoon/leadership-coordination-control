  "round_budget": {
    "closed_ended": 3,
    "integration": 4
  },
  "generation": {
    "temperature": 0.35,
    "max_tokens": 512,
    "extra_body": {
      "provider": {
        "order": [
          "DeepInfra"
        ],
        "allow_fallbacks": false
      }
    }
  },
  "runner": {
    "agent_parallelism": 3
  },
  "shared_round0_source": "outputs/runs/sr0_llama_4_scout_alphanli"
}
