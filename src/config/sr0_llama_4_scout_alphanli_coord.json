    },
    {
      "name": "surface_match",
      "instruction": "Favor the answer that most directly matches the observations without adding extra assumptions."
    },
    {
      "name": "plausibility_first",
      "instruction": "Prefer the answer that best fits ordinary causal expectations in real life."
    }
  ],
  "seeds": [
    0,
    1,
    2
  ],
  "conditions": [
    "llm_coordinator"
